# BotFather token. Required for the live bot.
BOT_TOKEN=

# Optional. Without it, only "send <amount> USDC to @name" is parsed.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 32 bytes, hex. openssl rand -hex 32
KEY_ENCRYPTION_KEY=

DATABASE_URL=postgresql+asyncpg://pay:pay@127.0.0.1:5432/pay

# Provider RPC for Amoy. Do not use the public rpc-amoy.polygon.technology endpoint.
RPC_URL=https://polygon-amoy.g.alchemy.com/v2/your-key
CHAIN_ID=80002

# Separate keys. The bot process needs the relayer key only.
DEPLOYER_PRIVATE_KEY=
RELAYER_PRIVATE_KEY=

ROUTER_ADDRESS=
USDC_ADDRESS=

# Wei. New sends are refused below this relayer balance.
RELAYER_POL_THRESHOLD=10000000000000000
MAX_FEE_PER_GAS=500000000000
MAX_PRIORITY_FEE_PER_GAS=50000000000

# Optional Telegram chat that receives pause alerts.
ADMIN_TELEGRAM_ID=
